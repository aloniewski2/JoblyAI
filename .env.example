# Copy this file to server/.env and fill in your values

# Anthropic Claude API (for AI features: job extraction, resume matching, AI assistant)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (for Gmail integration — read-only tracking)
# Create credentials at https://console.cloud.google.com
# Enable Gmail API, create OAuth 2.0 Client ID (Web Application)
# Add redirect URI: http://localhost:3001/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Server config (optional)
PORT=3001
